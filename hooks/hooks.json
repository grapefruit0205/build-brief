{
  "description": "Gate supported local mutations only after explicit Build Brief activation, with user opt-out and optional strict mode.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/build_brief_gate.py\" pre-tool",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\build_brief_gate.py\" pre-tool",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
